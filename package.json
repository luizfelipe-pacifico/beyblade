{
  "name": "beyblade-arena",
  "version": "1.0.0",
  "private": true,
  "description": "Jogo de Beyblade local para dois jogadores com manetes (Electron + Next.js, PostgreSQL no Docker via Prisma).",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "prestart": "node scripts/sync-art.js",
    "start": "node server.js",
    "predev": "node scripts/sync-art.js",
    "dev": "node --watch server.js",
    "dev:all": "node scripts/dev-all.js",
    "art:sync": "node scripts/sync-art.js",
    "build:research": "node scripts/build-research.js",
    "test": "node --test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "prepare": "git config core.hooksPath .githooks",
    "audio:tts": "node scripts/tts-falas.js",
    "art:vetorizar": "node scripts/vetorizar-retratos.js"
  },
  "engines": {
    "node": ">=24.11"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "express": "^5.1.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "imagetracerjs": "^1.2.6",
    "prisma": "^7.10.1",
    "sharp": "^0.35.5"
  }
}
